<Window x:Class="Novastrap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NovaStrap" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117">
    
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <Border Grid.Column="0" Grid.Row="0" Background="#11161C" CornerRadius="12" BorderBrush="#1E2A36" BorderThickness="1">
            <StackPanel Margin="16">
                <Border Background="#1F6FEB" CornerRadius="12" Height="70" Margin="0,0,0,25">
                    <TextBlock Text="NS" FontSize="28" FontWeight="Bold" Foreground="White" 
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Button x:Name="LaunchBtn" Click="LaunchRobloxBtn_Click" Background="#238636" Foreground="White" 
                        Height="45" Margin="0,5" FontWeight="Bold" FontSize="14">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="▶ " FontSize="16"/>
                        <TextBlock x:Name="LaunchText" Text="ЗАПУСТИТИ" FontSize="14"/>
                    </StackPanel>
                </Button>
                <Button x:Name="KillBtn" Click="KillRobloxBtn_Click" Background="#DA3633" Foreground="White" 
                        Height="40" Margin="0,5">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="■ " FontSize="16"/>
                        <TextBlock x:Name="KillText" Text="ЗАКРИТИ" FontSize="14"/>
                    </StackPanel>
                </Button>
                <Rectangle Height="1" Fill="#1E2A36" Margin="0,15"/>
                <Button x:Name="HomeBtn" Click="HomeNavBtn_Click" Background="#1F6FEB" Foreground="White" 
                        Height="40" Margin="0,5" FontWeight="SemiBold">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="🏠 " FontSize="16"/>
                        <TextBlock x:Name="HomeText" Text="ГОЛОВНА" FontSize="14"/>
                    </StackPanel>
                </Button>
                <Button x:Name="FFlagsBtn" Click="FFlagsNavBtn_Click" Background="#1F6FEB" Foreground="White" 
                        Height="40" Margin="0,5" FontWeight="SemiBold">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="⚡ " FontSize="16"/>
                        <TextBlock x:Name="FFlagsText" Text="FAST FLAGS" FontSize="14"/>
                    </StackPanel>
                </Button>
                <Button x:Name="SettingsBtn" Click="SettingsNavBtn_Click" Background="#1F6FEB" Foreground="White" 
                        Height="40" Margin="0,5" FontWeight="SemiBold">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="⚙️ " FontSize="16"/>
                        <TextBlock x:Name="SettingsText" Text="НАЛАШТУВАННЯ" FontSize="14"/>
                    </StackPanel>
                </Button>
                <Button x:Name="AboutBtn" Click="AboutNavBtn_Click" Background="#1F6FEB" Foreground="White" 
                        Height="40" Margin="0,5" FontWeight="SemiBold">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="ℹ️ " FontSize="16"/>
                        <TextBlock x:Name="AboutText" Text="ПРО ПРОГРАМУ" FontSize="14"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
        
        <Border Grid.Column="1" Grid.Row="0" Background="#11161C" CornerRadius="12" 
                BorderBrush="#1E2A36" BorderThickness="1" Padding="20">
            <Grid>
                <StackPanel x:Name="HomePanel" Visibility="Visible">
                    <TextBlock x:Name="HomeTitle" Text="Ласкаво просимо до NovaStrap!" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="RobloxStatus" Text="Roblox: ⚫ Не запущено" Foreground="#8B949E" Margin="0,15,0,10" FontSize="14"/>
                    <TextBlock x:Name="FlagsCount" Text="Активних прапорців: 0" Foreground="#8B949E" FontSize="14"/>
                    <Rectangle Height="1" Fill="#1E2A36" Margin="0,15"/>
                    <TextBlock x:Name="QuickTitle" Text="Швидкі дії:" Foreground="White" FontWeight="Bold" Margin="0,10,0,5"/>
                    <Button x:Name="QuickLaunch" Content="▶ Запустити Roblox" Click="LaunchRobloxBtn_Click" 
                            Background="#238636" Foreground="White" Height="35" Width="160" HorizontalAlignment="Left" Margin="0,5"/>
                    <Button x:Name="QuickReset" Content="🔄 Скинути прапорці" Click="ResetFlagsBtn_Click" 
                            Background="#DA3633" Foreground="White" Height="35" Width="160" HorizontalAlignment="Left" Margin="0,5"/>
                </StackPanel>
                
                <Grid x:Name="FFlagsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="FFlagsTitle" Text="⚡ FAST FLAGS EDITOR" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
                    <WrapPanel Grid.Row="1" Margin="0,0,0,15">
                        <Button x:Name="AddFlagBtn" Content="+ Додати" Click="AddFlagBtn_Click" Background="#238636" Foreground="White" Height="32" Width="100"/>
                        <Button x:Name="ApplyFlagsBtn" Content="💾 Зберегти" Click="ApplyFlagsBtn_Click" Background="#238636" Foreground="White" Height="32" Width="100" Margin="5,0"/>
                        <Button x:Name="ImportBtn" Content="📥 Імпорт" Click="ImportJsonFlags_Click" Background="#6E40C9" Foreground="White" Height="32" Width="100" Margin="5,0"/>
                        <Button x:Name="ExportBtn" Content="📤 Експорт" Click="ExportFlagsToJson_Click" Background="#1F6FEB" Foreground="White" Height="32" Width="100" Margin="5,0"/>
                        <Button x:Name="ClearBtn" Content="🗑️ Очистити" Click="ClearAllFlags_Click" Background="#DA3633" Foreground="White" Height="32" Width="100" Margin="5,0"/>
                    </WrapPanel>
                    <Grid Grid.Row="2" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Grid.Column="0" Height="32" TextChanged="SearchBox_TextChanged" 
                                 Background="#0D1117" Foreground="White" BorderBrush="#30363D"/>
                        <ComboBox x:Name="CategoryCombo" Grid.Column="1" Height="32" Margin="10,0,0,0"
                                  SelectionChanged="CategoryCombo_SelectionChanged"
                                  Background="#0D1117" Foreground="White" BorderBrush="#30363D"/>
                        <TextBlock x:Name="FilterStats" Grid.Column="2" Text="0 / 0" Foreground="#8B949E" 
                                   VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12"/>
                    </Grid>
                    <ScrollViewer Grid.Row="3">
                        <DataGrid x:Name="FlagsGrid" Background="#0D1117" Foreground="White" AutoGenerateColumns="False" 
                                  RowBackground="#161B22" AlternatingRowBackground="#1A1F2E" BorderThickness="0"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn x:Name="FlagCol" Header="Прапорець" Binding="{Binding Key}" Width="2*"/>
                                <DataGridTextColumn x:Name="ValueCol" Header="Значення" Binding="{Binding Value}" Width="*"/>
                                <DataGridTemplateColumn x:Name="TypeCol" Header="Тип" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedValue="{Binding Type}" SelectedValuePath="Content"
                                                      Background="#161B22" Foreground="White" BorderBrush="#30363D">
                                                <ComboBoxItem Content="String"/>
                                                <ComboBoxItem Content="Boolean"/>
                                                <ComboBoxItem Content="Number"/>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header=" " Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="❌" Click="RemoveFlag_Click" Tag="{Binding}"
                                                    Background="Transparent" Foreground="#DA3633" 
                                                    BorderThickness="0" FontSize="12" Width="25" Height="25"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>
                    <TextBlock x:Name="FlagsStatus" Grid.Row="4" Text="Готово" Foreground="#8B949E" FontSize="11" Margin="0,10,0,0"/>
                </Grid>
                
                <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
                    <TextBlock x:Name="SettingsTitle" Text="⚙️ НАЛАШТУВАННЯ" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <Border Background="#1A1F2E" CornerRadius="10" Padding="15" Margin="0,20,0,0">
                        <StackPanel>
                            <TextBlock x:Name="LangTitle" Text="🌐 МОВА" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="LangUA" Content="🇺🇦 Українська" GroupName="Language" 
                                             Checked="LanguageChanged" Foreground="White" Margin="0,0,30,0"/>
                                <RadioButton x:Name="LangEN" Content="🇬🇧 English" GroupName="Language" 
                                             Checked="LanguageChanged" Foreground="White"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="RobloxPathText" Text="ШЛЯХ ДО ROBLOX" Foreground="White" FontWeight="Bold" Margin="0,15,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RobloxPathBox" Background="#0D1117" Foreground="White" BorderBrush="#30363D" Height="35"/>
                        <Button x:Name="BrowseBtn" Grid.Column="1" Content="ОГЛЯД" Click="BrowseRobloxBtn_Click" 
                                Background="#1F6FEB" Foreground="White" Width="70" Margin="10,0,0,0"/>
                    </Grid>
                    <CheckBox x:Name="AutoDetectBox" Content="Автоматично знаходити Roblox" IsChecked="True" Foreground="#8B949E" Margin="0,15,0,0"/>
                    <Button x:Name="SaveSettingsBtn" Content="💾 ЗБЕРЕГТИ НАЛАШТУВАННЯ" Click="SaveSettingsBtn_Click" 
                            Background="#238636" Foreground="White" Width="220" Height="35" HorizontalAlignment="Left" Margin="0,20,0,0"/>
                </StackPanel>
                
                <StackPanel x:Name="AboutPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Background="#1F6FEB" CornerRadius="20" Width="80" Height="80" Margin="0,0,0,20">
                        <TextBlock Text="NS" FontSize="36" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="AboutTitle" Text="NOVASTRAP" FontSize="32" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="AboutVer" Text="Версія 2.0" FontSize="14" Foreground="#1F6FEB" HorizontalAlignment="Center" Margin="0,5,0,20"/>
                    <TextBlock x:Name="AboutDesc" Text="Потужний лаунчер для Roblox з підтримкою Fast Flags" FontSize="13" Foreground="#8B949E" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="AboutCopy" Text="© 2025 NovaStrap Team" FontSize="11" Foreground="#8B949E" HorizontalAlignment="Center" Margin="0,30,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#0D1117" CornerRadius="8" Margin="0,10,0,0" Padding="10,5">
            <TextBlock x:Name="StatusBar" Text="✅ Готово" Foreground="#8B949E" FontSize="11"/>
        </Border>
    </Grid>
</Window>