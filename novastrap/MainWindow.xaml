<Window x:Class="Novastrap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Novastrap - Roblox Custom Launcher" 
        Height="600" 
        Width="900"
        Background="#1E1E2E">
    
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- БОКОВАЯ ПАНЕЛЬ (ПРОФИЛИ) -->
        <Border Grid.Column="0" Background="#2D2D3D" CornerRadius="8" Margin="0,0,10,0">
            <StackPanel Margin="10">
                <TextBlock Text="ПРОФИЛИ" Foreground="White" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                <ListBox x:Name="ProfileList" Background="#1E1E2E" Foreground="White" Height="200" SelectionChanged="ProfileList_SelectionChanged"/>
                <Button x:Name="NewProfileBtn" Content="+ Новый профиль" Click="NewProfileBtn_Click" Margin="0,5" Background="#4A4A5A" Foreground="White"/>
                <Button x:Name="DeleteProfileBtn" Content="Удалить профиль" Click="DeleteProfileBtn_Click" Margin="0,5" Background="#5A3A3A" Foreground="White"/>
                
                <Separator Margin="0,15" Background="#4A4A5A"/>
                
                <TextBlock Text="БЫСТРЫЕ ДЕЙСТВИЯ" Foreground="White" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                <Button x:Name="LaunchRobloxBtn" Content="▶ ЗАПУСТИТЬ ROBLOX" Click="LaunchRobloxBtn_Click" Margin="0,5" Background="#2A5A3A" Foreground="White" FontWeight="Bold" Height="40"/>
                <Button x:Name="ResetFlagsBtn" Content="Сбросить все флаги" Click="ResetFlagsBtn_Click" Margin="0,5" Background="#5A4A2A" Foreground="White"/>
            </StackPanel>
        </Border>
        
        <!-- ОСНОВНАЯ ОБЛАСТЬ -->
        <Grid Grid.Column="1">
            <TabControl Background="#2D2D3D" BorderThickness="0">
                
                <!-- ВКЛАДКА FAST FLAGS -->
                <TabItem Header="FAST FLAGS" Background="#3D3D4D" Foreground="White">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button x:Name="AddFlagBtn" Content="+ Добавить флаг" Click="AddFlagBtn_Click" Background="#4A6A8A" Foreground="White" Width="120"/>
                            <Button x:Name="ImportPresetBtn" Content="Загрузить пресет" Click="ImportPresetBtn_Click" Background="#6A4A6A" Foreground="White" Width="120" Margin="10,0,0,0"/>
                        </StackPanel>
                        
                        <DataGrid x:Name="FlagsGrid" Grid.Row="1" Background="#1E1E2E" Foreground="White" AutoGenerateColumns="False" 
                                  RowBackground="#2D2D3D" AlternatingRowBackground="#252535" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Название флага" Binding="{Binding Key}" Width="200">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="White"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Значение" Binding="{Binding Value}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#6ACD6A"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Тип" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedItem="{Binding Type}" Background="#3D3D4D" Foreground="White">
                                                <ComboBoxItem Content="String"/>
                                                <ComboBoxItem Content="Boolean"/>
                                                <ComboBoxItem Content="Number"/>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="X" Click="RemoveFlag_Click" Background="Transparent" Foreground="Red" BorderThickness="0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        
                        <Button x:Name="SaveFlagsBtn" Grid.Row="2" Content="Сохранить флаги в профиль" Click="SaveFlagsBtn_Click" 
                                Background="#2A5A3A" Foreground="White" Height="35" Margin="0,10,0,0"/>
                    </Grid>
                </TabItem>
                
                <!-- ВКЛАДКА FFLAG INJECT -->
                <TabItem Header="FFLAG INJECT" Background="#3D3D4D" Foreground="White">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Text="Вставь сюда код FFlags (JSON или формат Key=Value)" Foreground="White" Margin="0,0,0,10"/>
                        <TextBox x:Name="FFlagCodeBox" Grid.Row="1" Background="#1E1E2E" Foreground="#6ACD6A" FontFamily="Consolas" 
                                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="200"/>
                        <Button x:Name="InjectFFlagBtn" Grid.Row="2" Content="ИНЖЕКТ В ROBLOX" Click="InjectFFlagBtn_Click" 
                                Background="#5A2A2A" Foreground="White" Height="40" Margin="0,10,0,0"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>